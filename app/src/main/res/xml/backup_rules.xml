<?xml version="1.0" encoding="utf-8"?>
<!-- Copias de seguridad desactivadas (allowBackup=false): la base de usuarios y la bitácora
     no deben salir del celular. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
