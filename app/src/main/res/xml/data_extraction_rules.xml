<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de la app se respalda en la nube ni se transfiere entre dispositivos (credenciales y bitácora). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
